#!/bin/sh
set -eu

# Custom RalyxOS filesystem image. Keep live-build's legacy security source
# disabled and explicitly select the Debian kernel package so this version of
# live-build does not try to download the unavailable Contents index.
lb config \
  --mode debian \
  --architectures amd64 \
  --distribution bookworm \
  --binary-images iso-hybrid \
  --archive-areas 'main contrib non-free-firmware' \
  --security false \
  --linux-packages 'linux-image-amd64' \
  --mirror-bootstrap https://deb.debian.org/debian/ \
  --mirror-chroot https://deb.debian.org/debian/ \
  --mirror-binary https://deb.debian.org/debian/ \
  --iso-application RalyxOS \
  --iso-volume RALYXOS
