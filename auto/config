#!/bin/sh
set -eu

# RalyxOS custom Debian-based installer/live filesystem with GRUB only.
# The singular --bootloader option is supported by live-build; --bootloaders
# is not. Disabling automatic kernel discovery avoids the obsolete Contents
# index lookup seen in the GitHub runner's live-build package.
lb config \
  --mode debian \
  --architectures amd64 \
  --distribution bookworm \
  --binary-images iso-hybrid \
  --bootloader grub \
  --archive-areas 'main contrib non-free-firmware' \
  --security false \
  --linux-packages none \
  --mirror-bootstrap https://deb.debian.org/debian/ \
  --mirror-chroot https://deb.debian.org/debian/ \
  --mirror-binary https://deb.debian.org/debian/ \
  --iso-application RalyxOS \
  --iso-volume RALYXOS
