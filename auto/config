#!/bin/sh
set -eu

# Build the custom RalyxOS filesystem. Disable live-build's automatic kernel
# discovery: this old live-build release downloads a missing Contents index.
# The kernel is installed normally from the package list instead.
lb config \
  --mode debian \
  --architectures amd64 \
  --distribution bookworm \
  --binary-images iso-hybrid \
  --archive-areas 'main contrib non-free-firmware' \
  --security false \
  --linux-packages none \
  --mirror-bootstrap https://deb.debian.org/debian/ \
  --mirror-chroot https://deb.debian.org/debian/ \
  --mirror-binary https://deb.debian.org/debian/ \
  --iso-application RalyxOS \
  --iso-volume RALYXOS
